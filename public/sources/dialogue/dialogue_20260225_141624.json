[
    {
        "dialogues": [
            {
                "name": "旁白",
                "dialogue_content": "血月圣所核心殿内。"
            },
            {
                "name": "旁白",
                "dialogue_content": "Velithra与Lorien终于抵达终点。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "这里就是终点？"
            },
            {
                "name": "Lorien",
                "dialogue_content": "看那浮雕。"
            },
            {
                "name": "Lorien",
                "dialogue_content": "与古老传说一模一样。"
            },
            {
                "name": "旁白",
                "dialogue_content": "Velithra的目光被吸引。"
            },
            {
                "name": "旁白",
                "dialogue_content": "她缓缓走向水晶棺椁。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "母亲？父亲？是你们吗？"
            },
            {
                "name": "旁白",
                "dialogue_content": "祭坛突然光芒大盛。"
            },
            {
                "name": "旁白",
                "dialogue_content": "Seraphina的幻影浮现出来。"
            },
            {
                "name": "Seraphina（幻影）",
                "dialogue_content": "亲爱的孩子。你终于来了。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "母亲？真的是你？"
            },
            {
                "name": "Velithra",
                "dialogue_content": "这到底是怎么回事？"
            },
            {
                "name": "Seraphina（幻影）",
                "dialogue_content": "你的血脉不是诅咒。"
            },
            {
                "name": "Seraphina（幻影）",
                "dialogue_content": "它是一个古老的封印。"
            },
            {
                "name": "Seraphina（幻影）",
                "dialogue_content": "封印着月神与夜神的神性。"
            },
            {
                "name": "Alistair（幻影）",
                "dialogue_content": "孩子，我们从未抛弃你。"
            },
            {
                "name": "Alistair（幻影）",
                "dialogue_content": "我们选择在此长眠。"
            },
            {
                "name": "Alistair（幻影）",
                "dialogue_content": "只为守护你平安成长。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "守护我？为什么这样做？"
            },
            {
                "name": "Seraphina（幻影）",
                "dialogue_content": "完全觉醒将失去人性。"
            },
            {
                "name": "Seraphina（幻影）",
                "dialogue_content": "我们不希望你成为无情神祇。"
            },
            {
                "name": "Alistair（幻影）",
                "dialogue_content": "我们希望你找到第三条路。"
            },
            {
                "name": "Alistair（幻影）",
                "dialogue_content": "一条真正属于你自己的路。"
            },
            {
                "name": "旁白",
                "dialogue_content": "浮雕墙忽然光芒四射。"
            },
            {
                "name": "旁白",
                "dialogue_content": "展现出上古的史诗画卷。"
            },
            {
                "name": "旁白",
                "dialogue_content": "月神与夜神本为一体。"
            },
            {
                "name": "旁白",
                "dialogue_content": "因理念分歧而撕裂神格。"
            },
            {
                "name": "旁白",
                "dialogue_content": "他们的后代成为精灵。"
            },
            {
                "name": "旁白",
                "dialogue_content": "以及吸血鬼的始祖。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "所以战争源于神的分裂？"
            },
            {
                "name": "Lorien",
                "dialogue_content": "而你是重新融合的钥匙？"
            },
            {
                "name": "旁白",
                "dialogue_content": "幻象再次变化。"
            },
            {
                "name": "旁白",
                "dialogue_content": "出现了Arandor的面孔。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "首席大法师？竟然是他！"
            },
            {
                "name": "Lorien",
                "dialogue_content": "我的叔父？这是真的吗？"
            },
            {
                "name": "Alistair（幻影）",
                "dialogue_content": "他是第一个实验体。"
            },
            {
                "name": "Alistair（幻影）",
                "dialogue_content": "力量吞噬了他的心智。"
            },
            {
                "name": "Seraphina（幻影）",
                "dialogue_content": "他渴望夺取你的神性。"
            },
            {
                "name": "Seraphina（幻影）",
                "dialogue_content": "他想成为统治世界的新神。"
            },
            {
                "name": "旁白",
                "dialogue_content": "圣所外忽然传来巨响。"
            },
            {
                "name": "旁白",
                "dialogue_content": "还夹杂着阵阵喊杀声。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "外面发生了什么？"
            },
            {
                "name": "Lorien",
                "dialogue_content": "是三股势力！他们追来了！"
            },
            {
                "name": "Elara（画外音）",
                "dialogue_content": "Velithra！快完成觉醒！"
            },
            {
                "name": "Elara（画外音）",
                "dialogue_content": "只有神性能阻止屠杀！"
            },
            {
                "name": "旁白",
                "dialogue_content": "祭坛开始剧烈震动。"
            },
            {
                "name": "旁白",
                "dialogue_content": "三件遗物从Velithra体内飞出。"
            },
            {
                "name": "旁白",
                "dialogue_content": "日光水晶与夜泪宝石旋转。"
            },
            {
                "name": "旁白",
                "dialogue_content": "黄昏徽章开始与它们融合。"
            },
            {
                "name": "旁白",
                "dialogue_content": "它们汇聚成璀璨的冠冕。"
            },
            {
                "name": "Arandor（画外音）",
                "dialogue_content": "侄女！把它给我！"
            },
            {
                "name": "旁白",
                "dialogue_content": "Arandor撕裂空间闯入大殿。"
            },
            {
                "name": "旁白",
                "dialogue_content": "他面容扭曲而疯狂。"
            },
            {
                "name": "Arandor",
                "dialogue_content": "我们才应该是一体的！"
            },
            {
                "name": "Arandor",
                "dialogue_content": "让我们一起统治世界！"
            },
            {
                "name": "Lorien",
                "dialogue_content": "休想伤害她！"
            },
            {
                "name": "旁白",
                "dialogue_content": "Lorien挺身挡在前面。"
            },
            {
                "name": "旁白",
                "dialogue_content": "Arandor挥出致命的魔法。"
            },
            {
                "name": "旁白",
                "dialogue_content": "魔法击中Lorien胸口。"
            },
            {
                "name": "Lorien",
                "dialogue_content": "呃啊！"
            },
            {
                "name": "Velithra",
                "dialogue_content": "Lorien！不！"
            },
            {
                "name": "旁白",
                "dialogue_content": "Velithra抱住倒下的Lorien。"
            },
            {
                "name": "旁白",
                "dialogue_content": "冠冕悬浮在她头顶。"
            },
            {
                "name": "旁白",
                "dialogue_content": "双月光辉穿透圣所穹顶。"
            },
            {
                "name": "旁白",
                "dialogue_content": "光辉灌注她的全身。"
            },
            {
                "name": "旁白",
                "dialogue_content": "她意识深处见到神祇残影。"
            },
            {
                "name": "月神残影",
                "dialogue_content": "成为规则吧。"
            },
            {
                "name": "月神残影",
                "dialogue_content": "缔造永恒和平。"
            },
            {
                "name": "夜神残影",
                "dialogue_content": "保留人性吧。"
            },
            {
                "name": "夜神残影",
                "dialogue_content": "体验爱与温度。"
            },
            {
                "name": "旁白",
                "dialogue_content": "现实中Velithra力量澎湃。"
            },
            {
                "name": "旁白",
                "dialogue_content": "她的银发化为光流。"
            },
            {
                "name": "旁白",
                "dialogue_content": "她挥手分开了外界军队。"
            },
            {
                "name": "旁白",
                "dialogue_content": "她一眼将Arandor定格。"
            },
            {
                "name": "Velithra（内心独白）",
                "dialogue_content": "情感在飞速流逝。"
            },
            {
                "name": "Velithra（内心独白）",
                "dialogue_content": "Lorien变成了冰冷数据。"
            },
            {
                "name": "Velithra（内心独白）",
                "dialogue_content": "不，这不是我要的。"
            },
            {
                "name": "旁白",
                "dialogue_content": "她低头看向怀中爱人。"
            },
            {
                "name": "旁白",
                "dialogue_content": "又看向疯狂叫嚣的Arandor。"
            },
            {
                "name": "旁白",
                "dialogue_content": "以及外界的无尽战火。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "我明白了。"
            },
            {
                "name": "旁白",
                "dialogue_content": "她毅然摘下头顶冠冕。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "我选择成为我自己！"
            },
            {
                "name": "旁白",
                "dialogue_content": "她将冠冕砸向祭坛。"
            },
            {
                "name": "旁白",
                "dialogue_content": "神性光辉破碎四散。"
            },
            {
                "name": "旁白",
                "dialogue_content": "大部分光辉注入Lorien体内。"
            },
            {
                "name": "旁白",
                "dialogue_content": "光辉治愈了他的致命伤。"
            },
            {
                "name": "旁白",
                "dialogue_content": "Velithra恢复了凡躯。"
            },
            {
                "name": "旁白",
                "dialogue_content": "但血脉达成了完美平衡。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "我，Velithra Amaris。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "不成为神。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "也不归属任何一族。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "我将走自己的路。"
            },
            {
                "name": "旁白",
                "dialogue_content": "她扶起苏醒的Lorien。"
            },
            {
                "name": "旁白",
                "dialogue_content": "两人并肩而立。"
            },
            {
                "name": "Velithra",
                "dialogue_content": "我们一起。"
            },
            {
                "name": "Lorien",
                "dialogue_content": "嗯，一起。"
            },
            {
                "name": "旁白",
                "dialogue_content": "祭坛上幻影相视一笑。"
            },
            {
                "name": "旁白",
                "dialogue_content": "Seraphina与Alistair消散。"
            }
        ],
        "chapter_name": "终焉的选择：神性与自我",
        "site": "名称：血月圣所·核心祭坛殿\n地点：悬浮于大陆尽头、深渊悬崖之上的倒立金字塔形建筑的最深处。\n装饰与场景：大殿呈完美的圆形，高耸的穹顶上精细地刻满了日月星辰的古老浮雕。墙壁由独特的深紫色发光水晶砌成。水晶内部持续流淌着暗银与血红色的微光。地面光滑如镜，清晰地倒映着穹顶图案。大殿中央是一座凸起的圆形祭坛。祭坛由黑白两色的未知石材交错铺成。石材构成了巨大的阴阳太极纹路。祭坛两侧对称安置着两具透明水晶棺椁。棺内隐约可见沉睡的人影轮廓。祭坛后方是一面占据整墙的巨大浮雕。浮雕描绘着两位背靠背的神祇形象。一位散发着纯净光辉。另一位笼罩在深邃暗影之中。整个空间弥漫着静谧古老的气息。空气中能听到微弱的魔力嗡鸣声。"
    }
]
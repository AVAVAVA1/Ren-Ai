[
    {
        "dialogues": [
            {
                "name": "旁白",
                "dialogue_content": "清晨的阳光透过咖啡厅落地窗。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "在木质桌面上投下温暖光斑。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "咖啡机蒸汽发出嘶鸣声。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "柜台前排着五六人的队伍。",
                "character": ""
            },
            {
                "name": "艾米丽",
                "dialogue_content": "您好，这是您的拿铁。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "手机在围裙口袋里震动起来。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "屏幕上显示妈妈来电。",
                "character": ""
            },
            {
                "name": "艾米丽",
                "dialogue_content": "请稍等，我离开一下。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽快步走向后厨储物间。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "狭小空间堆着纸箱。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "还有不少咖啡豆袋。",
                "character": ""
            },
            {
                "name": "艾米丽",
                "dialogue_content": "妈，我正在上班。",
                "character": "/sources/pic/艾米丽/depression_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "电话那头传来清晰声音。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "语调带着不容置疑。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "周六莉莉婚礼要到了。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "妹妹特意留了并排座位。",
                "character": ""
            },
            {
                "name": "艾米丽",
                "dialogue_content": "他应该能来参加。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "妈妈声音透出担忧。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "两年都没见过这位马克。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "连照片都没有一张。",
                "character": ""
            },
            {
                "name": "艾米丽",
                "dialogue_content": "医院轮班真的很忙。",
                "character": "/sources/pic/艾米丽/depression_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "电话那头传来叹息声。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "要求周六必须带他来。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "电话被挂断了。",
                "character": ""
            },
            {
                "name": "艾米丽",
                "dialogue_content": "这该怎么办才好。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "呼吸变得微微急促。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "额头抵在冰冷墙壁上。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "停留了整整十秒钟。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "重新戴上职业性微笑。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "推门回到咖啡厅柜台。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "柜台前队伍已经缩短。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "门铃这时轻轻响起。",
                "character": ""
            },
            {
                "name": "Larok",
                "dialogue_content": "早上好。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "还是老样子对吗？",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "双层芝士汉堡套餐。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "可乐不加冰。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "你的记性真好。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽转身准备餐点。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "手包装时微微发抖。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "将餐盘推向柜台边。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "Larok伸手来接餐盘。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽没有松开手。",
                "character": ""
            },
            {
                "name": "Larok",
                "dialogue_content": "怎么了？",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽抬起头又躲开。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "她的脸颊变得涨红。",
                "character": ""
            },
            {
                "name": "艾米丽",
                "dialogue_content": "对不起我知道这很疯。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我们甚至不算认识。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "但我妹妹周六结婚。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我妈妈非要见男朋友。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "其实那是我编造的。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "从来没有这样的人。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "如果我一个人去的话。",
                "character": "/sources/pic/艾米丽/depression_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "妈妈会失望整整一年。",
                "character": "/sources/pic/艾米丽/depression_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "她那种眼神我受不了。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "话语变得混乱堆积。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "Larok静静听着没有打断。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "手指仍搭在餐盘边缘。",
                "character": ""
            },
            {
                "name": "艾米丽",
                "dialogue_content": "你能假装我男朋友吗？",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "就周六一天几个小时。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我可以说你是医生。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "或者任何职业都可以。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "求你了帮帮我好吗？",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "空气仿佛突然凝固。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "背景音变得遥远模糊。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽不敢抬头等待。",
                "character": ""
            },
            {
                "name": "Larok",
                "dialogue_content": "周六具体几点开始？",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽猛地抬起头来。",
                "character": ""
            },
            {
                "name": "Larok",
                "dialogue_content": "需要我穿得像医生吗？",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "我有件画荧光骷髅的。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽张了张嘴发不出声。",
                "character": ""
            },
            {
                "name": "Larok",
                "dialogue_content": "刚才只是开玩笑的。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "地点时间和着装要求。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "短信告诉我细节吧。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "她拿起餐盘转身离开。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "走向常坐的靠窗位置。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "仿佛只是普通点单。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽站在原地不动。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "双手紧抓围裙边缘。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "窗外Larok戴上太阳镜。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "开始安静地吃汉堡。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "尖耳在发丝间若隐若现。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "场景渐渐淡出结束。",
                "character": ""
            }
        ],
        "chapter_name": "清晨的请求",
        "site": "咖啡厅内部，清晨阳光透过大面积落地窗洒入，在深色木质桌面上形成明亮光斑。空气里弥漫着现磨咖啡豆的香气与隐约的烘焙甜味。柜台后方不锈钢咖啡机亮着指示灯，蒸汽管安静悬挂。室内摆放着约十张圆桌与高脚椅，靠窗位置视野开阔可见街道。墙面装饰着复古电影海报与绿植挂架，暖黄色吊灯在未开启状态下静止。地面铺着几何图案瓷砖，靠近门口处有一个小型书架。整体环境整洁明亮，背景播放着轻柔的爵士乐。"
    },
    {
        "dialogues": [
            {
                "name": "旁白",
                "dialogue_content": "两天后的夜晚，公寓客厅里。",
                "character": ""
            },
            {
                "name": "艾米丽",
                "dialogue_content": "所以……基础设定。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我们是在伦敦认识的。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "那是一年前的事。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "你在那里做什么呢？",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "旅行。画画。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "偶尔在街头卖艺。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "好，艺术家身份。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "但对我家人要改说。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "“自由视觉设计师”。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我们在咖啡店相遇。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我差点洒了拿铁。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "洒在你的素描本上。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "实际你撞到桌子。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "整杯咖啡倒下去了。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "毁了我三天的手稿。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "真的吗？",
                "character": "/sources/pic/艾米丽/surprise_1.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "这样更可信。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "愤怒的初遇很戏剧。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "你坚持请吃饭道歉。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "然后发现共同爱好。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "我们都爱糟糕科幻片。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "好。就这样吧。",
                "character": "/sources/pic/艾米丽/depression_1.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "现在练习肢体语言。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "家人会观察互动。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "Larok站起身走近。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "她向艾米丽伸出手。",
                "character": ""
            },
            {
                "name": "Larok",
                "dialogue_content": "牵手。情侣不这样。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "不会像谈判代表说话。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽迟疑地伸手。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "放在Larok的掌心。",
                "character": ""
            },
            {
                "name": "Larok",
                "dialogue_content": "太僵硬了。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "想象我们是朋友。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "放松一些。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我没什么朋友。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "会这样牵手。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "那就想象抢银行。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "我们是共犯关系。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "信任但准备逃跑。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽忍不住笑了。",
                "character": ""
            },
            {
                "name": "旁白",
                "dialogue_content": "她手指力道放松些。",
                "character": ""
            },
            {
                "name": "Larok",
                "dialogue_content": "好一点。现在称呼。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "你叫我什么？",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "Larok？",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "太正式。试试昵称。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "Lara？或者Rok？",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {

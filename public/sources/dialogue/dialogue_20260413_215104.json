[
    {
        "dialogues": [
            {
                "name": "旁白",
                "dialogue_content": "清晨的阳光透过落地窗。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "洒在暖色调的木质地板上。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "咖啡机发出规律的嘶嘶声。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "空气里弥漫着烘焙豆的香气。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "和刚出炉牛角包的黄油味。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "早安，史密斯先生。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "您的松饼。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "祝您有美好的一天！",
                "character": "/sources/pic/艾米丽/happy_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "门铃轻响。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽抬头看见Larok。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "早上好，Larok！",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "老样子吗？",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "大杯美式。",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "加热的杏仁牛角包？",
                "character": "/sources/pic/艾米丽/smile_1.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "没错，谢谢。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽转身操作咖啡机。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "她的手指几不可察地颤抖。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "她舀咖啡豆时多舀了半勺。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "又慌忙倒回去。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "接热水时差点烫到手背。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "您、您的餐点好了。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "谢谢。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "Larok走向靠窗的固定座位。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽假装忙碌地擦拭柜台。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "她的余光却一直追随着。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "心跳得很快，掌心出汗。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "早晨的高峰期逐渐过去。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "咖啡厅里只剩下零星客人。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "Larok慢条斯理吃着牛角包。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽深吸一口气。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "她解下围裙，又系上。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "最终，她绕过柜台走去。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "每走一步，脸颊就更烫一分。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "Larok正翻过一页报纸。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "察觉到有人靠近，抬起头。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "那个……Larok先生。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "抱歉打扰您用餐。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我有件事想请求您。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "是非常冒昧的事。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "请说。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我来自非常传统的家庭。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我父母坚信人生大事。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "应该在合适的年龄完成。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "结婚，生子，稳定生活。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "而我妹妹莉莉要结婚了。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "是盛大的婚礼。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "在格兰德酒店。",
                "character": "/sources/pic/艾米丽/sad_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "她停顿，呼吸有些急促。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "他们一直对我施加压力。",
                "character": "/sources/pic/艾米丽/depression_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "每次家庭聚会都问。",
                "character": "/sources/pic/艾米丽/depression_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "莉莉都要结婚了，你呢？",
                "character": "/sources/pic/艾米丽/depression_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我们只是担心你孤单。",
                "character": "/sources/pic/艾米丽/depression_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "Larok安静地听着。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "上周，我妈妈打电话来。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我又一次被提起。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我当时工作很累。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "房租账单来了。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "烤箱又坏了。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我一时冲动就撒谎了。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我说我有男朋友了。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "一个可靠善良的男人。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我说我们交往几个月。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "感情非常稳定。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "而我描述的那个人……",
                "character": "/sources/pic/艾米丽/tsundere_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我想到的是您。",
                "character": "/sources/pic/艾米丽/tsundere_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "是每天早晨来的您。",
                "character": "/sources/pic/艾米丽/tsundere_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "安静喝咖啡，礼貌道谢。",
                "character": "/sources/pic/艾米丽/tsundere_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我不知道为什么那样说。",
                "character": "/sources/pic/艾米丽/surprise_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "但话已经出口了。",
                "character": "/sources/pic/艾米丽/surprise_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "现在他们要求我带人。",
                "character": "/sources/pic/艾米丽/surprise_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "参加这周六的婚礼。",
                "character": "/sources/pic/艾米丽/surprise_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "所以我能不能请求您？",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "假装成我的男朋友。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "就这周六一天。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "出席我妹妹的婚礼。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "拜托了！",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我知道这太荒唐。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我知道这太冒昧。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "但我真的没有别的办法。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "沉默在两人之间蔓延。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我会处理好一切细节！",
                "character": "/sources/pic/艾米丽/anger_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "您只需要出现一下。",
                "character": "/sources/pic/艾米丽/anger_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "和我一起露个面就好！",
                "character": "/sources/pic/艾米丽/anger_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我甚至可以告诉妈妈。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "您是位医生。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "如果这样更有帮助的话！",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "或者其他任何职业！",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "您只需要配合我演戏。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "几个小时就好。",
                "character": "/sources/pic/艾米丽/shy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "求您了。",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "她的声音在颤抖。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "手指紧紧攥着围裙。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "指节发白。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            }
        ],
        "chapter_name": "清晨的请求",
        "site": "**地点详细描述**\n\n**名称**：本地咖啡厅“每日豆”\n\n**地点**：位于城市一条宁静的街道转角处，毗邻写字楼与住宅区。\n\n**装饰与场景**：\n- **整体氛围**：温馨、明亮，以暖色调为主。清晨阳光能充分透过临街的整面落地窗照射进来。\n- **地面**：铺陈着暖色调的木质地板，部分区域因常年使用而色泽温润。\n- **墙面**：一侧为砖墙，保留原始质感，悬挂着本地艺术家的黑白摄影作品；另一侧为浅米色墙面，嵌有木质书架，摆放着书籍和绿植。\n- **柜台与工作区**：深色木质柜台，后方墙上挂着黑板手写菜单。专业的意式咖啡机、磨豆机、陈列糕点的玻璃柜井然有序。空气持续弥漫着现磨咖啡豆的香气与烘焙糕点的黄油味。\n- **座位区**：分散摆放着约十张大小不一的木质圆桌与方桌，配有舒适布艺或皮质座椅。窗边有一排高脚凳与长条桌，可观赏街景。Larok的固定座位是一张靠窗的两人方桌，桌面有木纹。\n- **照明**：白天主要依靠自然光，辅以几盏悬挂的暖光吊灯。夜晚则依靠吊灯与壁灯营造柔和光线。\n- **细节**：入口处有清脆的门铃，收银台旁有小型报刊架。背景音乐播放着轻柔的爵士乐或独立音乐，音量适中。整体环境整洁，是附近居民与上班族每日光顾的熟悉场所。"
    },
    {
        "dialogues": [
            {
                "name": "旁白",
                "dialogue_content": "傍晚六点，咖啡厅已挂上“休息中”的牌子。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "暖黄的吊灯在木质桌面上投下光圈。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "旁白",
                "dialogue_content": "艾米丽和Larok面对面坐着，桌上摊着一个笔记本。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "我考虑过了。我可以帮你这个忙。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "真的吗？您……您真的愿意？",
                "character": "/sources/pic/艾米丽/surprise_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "天啊，谢谢您！我不知道该怎么感谢您……",
                "character": "/sources/pic/艾米丽/crying_1.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "但我们需要一个可信的故事。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "Larok",
                "dialogue_content": "你家人会问很多问题。",
                "character": "/sources/spirit/ComfyUI_00016_black.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "是的！我想过了。",
                "character": "/sources/pic/艾米丽/happy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "首先是我们怎么认识的。",
                "character": "/sources/pic/艾米丽/happy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "不能是在这里，太普通了。",
                "character": "/sources/pic/艾米丽/happy_1.png"
            },
            {
                "name": "艾米丽",
                "dialogue_content": "我告诉他们我们是在伦敦认识的！",
                "character": "/sources/pic/艾米丽/happy_1.png"
            },
            {
                "name": "艾米丽",

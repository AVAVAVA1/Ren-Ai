# 复制本文件为同目录下的 .env 后填写真实值（勿将 .env 提交到 Git）
# cp .env.example .env   （Linux/macOS）
# copy .env.example .env （Windows cmd）

# ---------- 大模型（OpenAI 兼容协议，默认 DeepSeek）----------
DS_API_KEY=
# 可选：中转或自建兼容端
# LLM_API_BASE=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# 也可用 LLM_API_KEY 或 OPENAI_API_KEY（与 DS_API_KEY 二选一时 const 会合并读取）

# ---------- 其它 API（按功能需要填写）----------
SILICONFLOW_API_KEY=
MODELSCOPE_API_KEY=
RunningHub_API_KEY=

# 本地 ComfyUI（与 public/comfyui/workflow1.json 节点 79/127/45 一致）
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# 可选：服务端默认 Checkpoint 文件名（设置页留空时使用）；不填则用工作流 JSON 里的 ckpt
# COMFYUI_DEFAULT_CHECKPOINT=waiIllustriousSDXL_v160 (1).safetensors
# 默认工作流 JSON 文件名（须位于 public/comfyui/，且可配同名 .mapping.json）
# COMFYUI_WORKFLOW_JSON=workflow1.json
# 等待 ComfyUI 出图并写入 history 的最长时间（秒），重型图建议 1800～3600
# COMFYUI_POLL_TIMEOUT=1800
# 默认分辨率 ratio（与 /api/image/comfyui-size-presets 中 ratio 一致）
# COMFYUI_SIZE_RATIO=1.0
# 立绘去背景：相对 public/comfyui/ 的 API 工作流（默认 sp_costum_workflow/remove_bg.json，需 RMBG 节点与模型）
# COMFYUI_REMOVE_BG_WORKFLOW=sp_costum_workflow/remove_bg.json
# 去背景任务轮询 /history 最长等待（秒），一般短于整图生图
# COMFYUI_REMOVE_BG_POLL_TIMEOUT=600

# 若代码或后续功能使用，可保留（当前主流程以 const.py 中变量为准）
# BRIA_API_TOKEN=
